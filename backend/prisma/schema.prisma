generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MERCHANT
  RIDER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bodyStats   BodyStats?
  allergies   Allergy[]
  notifPrefs  NotifPrefs?
  orders      Order[]
  dailyLogs   DailyLog[]
  restaurant  Restaurant?
  assignments DeliveryAssignment[]
}

model BodyStats {
  id            String        @id @default(cuid())
  userId        String        @unique
  age           Int
  weightKg      Float
  heightCm      Float
  gender        Gender
  activityLevel ActivityLevel
  bmr           Float
  rdaCalories   Float
  rdaProtein    Float
  rdaCarbs      Float
  rdaFat        Float
  rdaFiber      Float
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Allergy {
  id           String @id @default(cuid())
  userId       String
  allergenName String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, allergenName])
}

model NotifPrefs {
  id               String  @id @default(cuid())
  userId           String  @unique
  lowCaloriesAlert Boolean @default(true)
  lowProteinAlert  Boolean @default(true)
  lowCarbsAlert    Boolean @default(true)
  lowFatAlert      Boolean @default(false)
  lowFiberAlert    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Restaurant {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  name        String
  address     String
  cuisineTags String[] @default([])
  healthScore Float    @default(5.0)
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]
  orders    Order[]
}

model MenuItem {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String
  description   String   @default("")
  price         Float
  imageUrl      String   @default("")
  calories      Float
  protein       Float
  carbs         Float
  fat           Float
  fiber         Float
  cookingMethod String   @default("")
  ingredients   Json     @default("[]")
  allergens     String[] @default([])
  healthScore   Float    @default(5.0)
  isHealthy     Boolean  @default(false)
  isAvailable   Boolean  @default(true)
  discount      Float    @default(0)
  createdAt     DateTime @default(now())

  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  restaurantId    String
  status          OrderStatus @default(PLACED)
  totalPrice      Float
  totalCalories   Float
  deliveryAddress String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer   User               @relation(fields: [customerId], references: [id])
  restaurant Restaurant         @relation(fields: [restaurantId], references: [id])
  items      OrderItem[]
  assignment DeliveryAssignment?
}

model OrderItem {
  id               String @id @default(cuid())
  orderId          String
  menuItemId       String
  quantity         Int
  priceSnapshot    Float
  caloriesSnapshot Float

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model DeliveryAssignment {
  id          String         @id @default(cuid())
  orderId     String         @unique
  riderId     String
  status      DeliveryStatus @default(ASSIGNED)
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider User  @relation(fields: [riderId], references: [id])
}

model DailyLog {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now()) @db.Date
  caloriesConsumed Float    @default(0)
  proteinConsumed  Float    @default(0)
  carbsConsumed    Float    @default(0)
  fatConsumed      Float    @default(0)
  fiberConsumed    Float    @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
